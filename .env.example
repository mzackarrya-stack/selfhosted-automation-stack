# Copy to .env, fill in, then: chmod 600 .env
# .env is git-ignored. Never commit it.
#
# Secrets are deliberately empty: docker compose refuses to start until they are set.
# Generate each one with:  openssl rand -hex 32

# ---------------------------------------------------------------- domain and TLS
# DNS A (and AAAA, if the server has IPv6) record must point at this server first.
N8N_HOST=n8n.example.com
# Optional. Let's Encrypt stopped sending expiry reminder emails in 2025;
# scripts/healthcheck.sh is what warns you now.
LETSENCRYPT_EMAIL=
# 1 = Let's Encrypt staging CA (untrusted certificate, generous rate limits).
# Use it for the very first try; see README before switching back to 0.
LETSENCRYPT_STAGING=0

# ---------------------------------------------------------------- versions
# Pinned. Upgrade deliberately: back up, read the release notes, bump, pull.
N8N_VERSION=2.41.6
CERTBOT_VERSION=v5.8.0

# ---------------------------------------------------------------- secrets
POSTGRES_USER=n8n
POSTGRES_DB=n8n
POSTGRES_PASSWORD=
# Encrypts the credentials stored in the database. Store a copy in a password
# manager: a database backup restored with a different key cannot decrypt them.
N8N_ENCRYPTION_KEY=

# ---------------------------------------------------------------- n8n
TIMEZONE=Europe/Paris
N8N_DIAGNOSTICS_ENABLED=false
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_SSRF_PROTECTION_ENABLED=true
# Execution history kept in the database: 336 h = 14 days.
EXECUTIONS_DATA_MAX_AGE=336
EXECUTIONS_DATA_PRUNE_MAX_COUNT=10000

# ---------------------------------------------------------------- memory ceilings
# Limits, not reservations. Sized for a 4 GB VPS; lower them on 2 GB.
N8N_MEM_LIMIT=2g
POSTGRES_MEM_LIMIT=1g

# ---------------------------------------------------------------- backups (scripts/backup.sh)
BACKUP_DIR=/var/backups/n8n-stack
BACKUP_RETENTION_DAYS=14
# The backup refuses to start below this much free space, instead of
# filling the disk halfway through and taking n8n down with it.
BACKUP_MIN_FREE_MB=1024
# Optional off-site copy. Any configured rclone remote; use an rclone "crypt"
# remote so the provider never sees plaintext. Empty = local copies only.
RCLONE_REMOTE=
RCLONE_RETENTION_DAYS=30
# 1 = also send a Telegram message when a backup succeeds.
BACKUP_NOTIFY_SUCCESS=0

# ---------------------------------------------------------------- alerts (Telegram)
# Create a bot with @BotFather, send it one message, then read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- health checks (scripts/healthcheck.sh)
HEALTH_DISK_MAX_PCT=85
HEALTH_DISK_PATHS="/ /var/lib/docker"
HEALTH_CERT_MIN_DAYS=14
HEALTH_BACKUP_MAX_AGE_HOURS=26
# A check must fail this many runs in a row before it alerts (2 runs = 10 min).
HEALTH_FAIL_THRESHOLD=2
# Repeat an unresolved alert once every N hours. 0 = only on state change.
HEALTH_RENOTIFY_HOURS=24
HEALTH_STATE_FILE=/var/lib/n8n-stack/health.state
