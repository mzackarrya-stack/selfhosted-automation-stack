# Rendered by /opt/nginx/start.sh only once a certificate exists for ${N8N_HOST}.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# TLS for an unknown name, or no SNI at all: refuse the handshake rather than
# hand our certificate (and therefore our hostname) to whoever scans the IP.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${N8N_HOST};

    ssl_certificate     /etc/letsencrypt/live/${N8N_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${N8N_HOST}/privkey.pem;

    # Mozilla "intermediate" profile, minus the DHE suites (they need a dhparam file).
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    # No OCSP stapling: Let's Encrypt shut down its OCSP responders in 2025.

    # One year, this host only. No includeSubDomains: that would also force HTTPS
    # on every other subdomain of the parent domain, which this stack does not own.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Matches n8n's default N8N_PAYLOAD_SIZE_MAX (16 MiB). Raise both together.
    client_max_body_size 16m;

    location / {
        # A variable in proxy_pass makes nginx resolve "n8n" at request time
        # through the resolver above, instead of once at startup.
        set $n8n_upstream http://n8n:5678;
        proxy_pass $n8n_upstream;

        # The editor pushes live updates over a WebSocket.
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host $host;
        # nginx is the edge: overwrite any client-supplied X-Forwarded-For
        # rather than append to it. n8n trusts exactly one hop (N8N_PROXY_HOPS=1).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;

        # Streamed responses and long-running webhook calls.
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
